{
  "name": "leveling-app",
  "version": "1.0.0",
  "private": true,
  "description": "Tailwind CSS build tooling for the Leveling Adjustment Flask app",
  "scripts": {
    "build:css": "tailwindcss -i ./static/src/tailwind.css -o ./static/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./static/src/tailwind.css -o ./static/tailwind.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
